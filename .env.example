# Copy to .env.local and adjust if the Wagtail CMS runs somewhere other than
# the default. Omit entirely to use that default.
CMS_API_URL=http://127.0.0.1:8000/api/v2

# Package catalogs (Umrah/Hajj/Tours/Pakistan Tours) -- a separate, non-CMS
# read-only API on the same Django backend. Omit entirely to use that default.
PACKAGES_API_URL=http://127.0.0.1:8000/api/packages

# The site's own public URL, used for metadataBase (canonical/OG tags),
# sitemap.xml and robots.txt. Set this to the real production domain when
# deploying (e.g. on Vercel, add it as a project environment variable) --
# omit it locally to fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Public address of the R2 bucket that holds the site's photos (its pub-....r2.dev
# URL or a custom domain, no trailing slash). Set this ONLY AFTER running the
# backend's `migrate_images_to_r2` command, which copies the photos there --
# until then leave it unset and images keep loading from Unsplash. It's inlined
# at build time, so on Vercel set it and redeploy.
NEXT_PUBLIC_MEDIA_URL=
