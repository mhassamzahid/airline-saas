# Copy this file to .env and fill in real values for your machine.
# .env is gitignored -- it never gets committed.

# Omit this entirely to fall back to a local db.sqlite3 file (zero setup).
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/halcyon_cms

# Cloudflare R2 -- image/file storage (see README: "Image storage (Cloudflare R2)").
# Leave all of these unset to store uploads on local disk (MEDIA_ROOT) instead.
# Create the key under R2 -> Manage API tokens -> Create API token (Object Read & Write,
# scoped to your bucket); that page shows the Access Key ID, Secret Access Key and
# the account's S3 endpoint. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The bucket's public address: its r2.dev URL or a custom domain, no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
