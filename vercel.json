{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "next build",
      "installCommand": "npm install"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "halcyon.wsgi:application"
    }
  },
  "rewrites": [
    { "source": "/django-admin/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/admin/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/documents/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/api/v2/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/api/packages/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/packages/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/search", "destination": { "type": "service", "service": "backend" } },
    { "source": "/static/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/media/:match*", "destination": { "type": "service", "service": "backend" } },
    { "source": "/(.*)", "destination": { "type": "service", "service": "frontend" } }
  ]
}
